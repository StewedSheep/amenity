<Layouts.flash_group flash={@flash} />

<!-- Hero Section -->
<div class="min-h-screen bg-gradient-to-br from-indigo-50 via-purple-50 to-pink-50">
  <div class="container mx-auto px-4 py-16">
    <!-- Header with Theme Toggle -->
    <div class="flex justify-end mb-8">
      <Layouts.theme_toggle />
    </div>

    <!-- Hero Content -->
    <div class="max-w-6xl mx-auto text-center">
      <div class="mb-8">
        <h1 class="text-7xl font-bold mb-6 bg-gradient-to-r from-indigo-600 via-purple-600 to-pink-600 bg-clip-text text-transparent">
          Welcome to Amenity
        </h1>
        <p class="text-2xl text-gray-700 mb-4">
          Your Modern Bible Study & Trivia Platform
        </p>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          Dive into scripture with interactive reading, create flashcards, compete in trivia battles, and connect with friends on your spiritual journey.
        </p>
      </div>

      <!-- CTA Buttons -->
      <div class="flex flex-wrap justify-center gap-4 mb-16">
        <a
          href="/users/register"
          class="btn btn-lg bg-gradient-to-r from-purple-600 via-pink-600 to-orange-500 text-white border-0 hover:shadow-2xl transform hover:scale-105 transition-all px-8"
        >
          🚀 Get Started
        </a>
        <a
          href="/users/log-in"
          class="btn btn-lg btn-outline border-2 border-purple-600 text-purple-600 hover:bg-purple-600 hover:text-white px-8"
        >
          🔑 Log In
        </a>
      </div>

      <!-- Features Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
        <!-- Bible Reading -->
        <div class="card bg-white shadow-xl hover:shadow-2xl transition-all transform hover:-translate-y-2">
          <div class="card-body items-center text-center">
            <div class="text-6xl mb-4">📖</div>
            <h3 class="card-title text-xl mb-2">Bible Reading</h3>
            <p class="text-gray-600">
              Read through the entire Bible (not really) with a beautiful, modern interface. Track your progress and mark chapters as read.
            </p>
          </div>
        </div>

        <!-- Study Tools -->
        <div class="card bg-white shadow-xl hover:shadow-2xl transition-all transform hover:-translate-y-2">
          <div class="card-body items-center text-center">
            <div class="text-6xl mb-4">📚</div>
            <h3 class="card-title text-xl mb-2">Study Tools</h3>
            <p class="text-gray-600">
              Create flashcards from verses, organize them into decks, and study with spaced repetition for better retention.
            </p>
          </div>
        </div>

        <!-- Trivia Battles -->
        <div class="card bg-white shadow-xl hover:shadow-2xl transition-all transform hover:-translate-y-2">
          <div class="card-body items-center text-center">
            <div class="text-6xl mb-4">🎮</div>
            <h3 class="card-title text-xl mb-2">Trivia Battles</h3>
            <p class="text-gray-600">
              Test your knowledge in exciting trivia games. Earn XP, level up, and unlock achievements as you play.
            </p>
          </div>
        </div>

        <!-- Social Features -->
        <div class="card bg-white shadow-xl hover:shadow-2xl transition-all transform hover:-translate-y-2">
          <div class="card-body items-center text-center">
            <div class="text-6xl mb-4">👥</div>
            <h3 class="card-title text-xl mb-2">Connect</h3>
            <p class="text-gray-600">
              Add friends, see their progress, and grow together in your faith journey with a supportive community.
            </p>
          </div>
        </div>
      </div>

      <!-- Gamification Section -->
      <div class="bg-gradient-to-r from-purple-100 to-pink-100 rounded-3xl p-8 mb-16">
        <h2 class="text-4xl font-bold mb-6 text-gray-800">🏆 Level Up Your Faith</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto">
          <div class="text-center">
            <div class="text-5xl mb-3">⭐</div>
            <h4 class="font-bold text-xl mb-2">Earn XP</h4>
            <p class="text-gray-700">
              Gain experience points by reading chapters, playing trivia, and studying flashcards.
            </p>
          </div>
          <div class="text-center">
            <div class="text-5xl mb-3">📈</div>
            <h4 class="font-bold text-xl mb-2">Level Up</h4>
            <p class="text-gray-700">
              Progress through levels as you engage with the platform and deepen your knowledge.
            </p>
          </div>
          <div class="text-center">
            <div class="text-5xl mb-3">🎯</div>
            <h4 class="font-bold text-xl mb-2">Achievements</h4>
            <p class="text-gray-700">
              Unlock special achievements for milestones like perfect games and consistent study.
            </p>
          </div>
        </div>
      </div>

      <!-- Quick Links -->
      <div class="bg-white rounded-3xl shadow-xl p-8">
        <%= if @current_scope do %>
          <h2 class="text-3xl font-bold mb-6 text-gray-800">Explore Amenity</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 max-w-4xl mx-auto">
            <a
              href="/bible"
              class="btn btn-lg bg-gradient-to-r from-blue-500 to-cyan-500 text-white border-0 hover:shadow-lg"
            >
              📖 Browse Bible
            </a>
            <a
              href="/study"
              class="btn btn-lg bg-gradient-to-r from-green-500 to-emerald-500 text-white border-0 hover:shadow-lg"
            >
              📚 Study Flashcards
            </a>
            <a
              href="/trivia"
              class="btn btn-lg bg-gradient-to-r from-orange-500 to-red-500 text-white border-0 hover:shadow-lg"
            >
              🎮 Play Trivia
            </a>
            <a
              href="/friends"
              class="btn btn-lg bg-gradient-to-r from-purple-500 to-pink-500 text-white border-0 hover:shadow-lg"
            >
              👥 Find Friends
            </a>
            <a
              href="/users/settings"
              class="btn btn-lg bg-gradient-to-r from-indigo-500 to-purple-500 text-white border-0 hover:shadow-lg"
            >
              ⚙️ Settings
            </a>
            <a
              href="/profile"
              class="btn btn-lg bg-gradient-to-r from-pink-500 to-rose-500 text-white border-0 hover:shadow-lg"
            >
              👤 Profile
            </a>
          </div>
        <% else %>
          <h2 class="text-3xl font-bold mb-6 text-gray-800">Ready to Begin?</h2>
          <p class="text-lg text-gray-600 mb-6 max-w-2xl mx-auto">
            Create a free account to unlock all features including Bible reading, flashcard creation, trivia games, and more!
          </p>
          <div class="flex flex-wrap justify-center gap-4">
            <a
              href="/users/register"
              class="btn btn-lg bg-gradient-to-r from-purple-600 via-pink-600 to-orange-500 text-white border-0 hover:shadow-2xl transform hover:scale-105 transition-all px-8"
            >
              🚀 Create Free Account
            </a>
            <a
              href="/users/log-in"
              class="btn btn-lg btn-outline border-2 border-purple-600 text-purple-600 hover:bg-purple-600 hover:text-white px-8"
            >
              🔑 Log In
            </a>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Footer -->
    <div class="text-center mt-16 text-gray-600">
      <p class="text-sm">
        Built with ❤️ using Phoenix Framework · Start your journey today
      </p>
    </div>
  </div>
</div>
